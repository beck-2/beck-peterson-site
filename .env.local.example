# Copy this file to .env.local and fill in your own MongoDB Atlas connection string.
# If MONGODB_URI is unset, local dev falls back to an in-memory MongoDB instance
# (via mongodb-memory-server) so you can develop without setting anything up —
# but that data does not persist between dev server restarts.
MONGODB_URI=

# Password for logging in as admin on the Logbook (lets you take down entries).
# Pick something only you know — it also acts as the signing secret for admin sessions.
ADMIN_PASSWORD=
